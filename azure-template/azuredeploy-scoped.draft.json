{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "DRAFT. Subscription-level variant of azuredeploy.json. Creates a resource group, a managed identity with a federated credential trusting Grafana's OIDC issuer, and Monitoring Reader role assignments at every scope listed in monitoringReaderScopes (subscriptions, resource groups, or individual resources, in any subscription the deployer can write role assignments in). Optionally grants AllDatabasesViewer on listed Azure Data Explorer clusters. No client secret is created."
  },
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-grafana-azure",
      "metadata": {
        "description": "Resource group that holds the managed identity. Created if createResourceGroup is true, otherwise it must already exist."
      }
    },
    "managedIdentityName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Leave empty to derive a unique name (mi-grafana-<hash>) from the issuer and subject, so each Grafana connection gets its own identity, federated credential, and role assignments. Set it only to reuse or pin a specific identity; two connections sharing a name overwrite each other's subject."
      }
    },
    "issuer": {
      "type": "string",
      "defaultValue": "https://jcolladokuri.github.io/azure-secretless-poc",
      "metadata": {
        "description": "Grafana's OIDC issuer URL. Do not change this — it must match exactly what Grafana's token service signs with."
      }
    },
    "subject": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Copy the subject value provided by the Grafana App for your connection and paste it here exactly as shown. A mismatch means auth will fail with AADSTS700213."
      }
    },
    "audience": {
      "type": "string",
      "defaultValue": "api://AzureADTokenExchange",
      "metadata": {
        "description": "Fixed audience Azure AD expects for workload identity federation. Do not change."
      }
    },
    "monitoringReaderScopes": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Additional scope IDs to grant Monitoring Reader on, merged with the three selections below. Full Azure resource IDs in the subscription being deployed to to grant Monitoring Reader on. Each entry can be the subscription itself (/subscriptions/<id>), a resource group (/subscriptions/<id>/resourceGroups/<rg>), or a single resource. Entries in any other subscription are ignored (see the ignoredScopes output); deploy again in that subscription instead. The deployer needs role-assignment write permission on each."
      }
    },
    "kustoClusterIds": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional. Full resource IDs of Azure Data Explorer (Kusto) clusters in the subscription being deployed to, e.g. /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Kusto/clusters/<name>. Azure RBAC alone doesn't grant Kusto query access — this grants Kusto's separate 'AllDatabasesViewer' cluster role. Clusters in other subscriptions are ignored (see ignoredScopes). Leave empty to skip."
      }
    },
    "subscriptionScopes": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Subscription scope IDs (/subscriptions/<id>). Only the subscription being deployed to is supported. Set by the portal form."
      }
    },
    "resourceGroupScopes": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Resource group scope IDs in the subscription being deployed to. Set by the portal form."
      }
    },
    "resourceScopes": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Individual resource IDs in the subscription being deployed to. Set by the portal form."
      }
    },
    "createResourceGroup": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "true creates the resource group named in resourceGroupName; false deploys into an existing resource group of that name (you need write access to it)."
      }
    }
  },
  "variables": {
    "federatedCredentialName": "grafana-federated",
    "monitoringReaderRoleId": "43d0d8ad-25c7-4714-9337-8ba259a9fe05",
    "identityDeploymentName": "grafana-identity",
    "identityDeploymentId": "[format('/subscriptions/{0}/resourceGroups/{1}/providers/Microsoft.Resources/deployments/{2}', subscription().subscriptionId, parameters('resourceGroupName'), variables('identityDeploymentName'))]",
    "allScopes": "[union(parameters('monitoringReaderScopes'), parameters('subscriptionScopes'), parameters('resourceGroupScopes'), parameters('resourceScopes'))]",
    "identityName": "[if(empty(parameters('managedIdentityName')), format('mi-grafana-{0}', uniqueString(parameters('issuer'), parameters('subject'))), parameters('managedIdentityName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2022-09-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[deployment().location]",
      "condition": "[parameters('createResourceGroup')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('identityDeploymentName')]",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "managedIdentityName": {
              "type": "string"
            },
            "federatedCredentialName": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[parameters('managedIdentityName')]",
              "location": "[resourceGroup().location]"
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}/{1}', parameters('managedIdentityName'), parameters('federatedCredentialName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
              ],
              "properties": {
                "issuer": "[parameters('issuer')]",
                "subject": "[parameters('subject')]",
                "audiences": [
                  "[parameters('audience')]"
                ]
              }
            }
          ],
          "outputs": {
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2023-01-31').principalId]"
            },
            "clientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2023-01-31').clientId]"
            }
          }
        },
        "parameters": {
          "managedIdentityName": {
            "value": "[variables('identityName')]"
          },
          "federatedCredentialName": {
            "value": "[variables('federatedCredentialName')]"
          },
          "issuer": {
            "value": "[parameters('issuer')]"
          },
          "subject": {
            "value": "[parameters('subject')]"
          },
          "audience": {
            "value": "[parameters('audience')]"
          }
        }
      }
    },
    {
      "comments": "Subscription-scope assignment: scope IDs with 3 segments, e.g. /subscriptions/<id>. Only the subscription this template is deployed to is supported; nested deployments cannot change subscription at subscription scope.",
      "condition": "[and(equals(length(split(variables('allScopes')[copyIndex()], '/')), 3), equals(split(variables('allScopes')[copyIndex()], '/')[2], subscription().subscriptionId))]",
      "copy": {
        "name": "subscriptionScopeCopy",
        "count": "[length(variables('allScopes'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('mr-sub-{0}', copyIndex())]",
      "location": "[deployment().location]",
      "dependsOn": [
        "[variables('identityDeploymentId')]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": {
              "type": "string"
            },
            "roleId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(subscription().id, parameters('principalId'), parameters('roleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        },
        "parameters": {
          "principalId": {
            "value": "[reference(variables('identityDeploymentId'), '2022-09-01').outputs.principalId.value]"
          },
          "roleId": {
            "value": "[variables('monitoringReaderRoleId')]"
          }
        }
      }
    },
    {
      "comments": "Resource-group-scope assignments: scope IDs with 5 segments, e.g. /subscriptions/<id>/resourceGroups/<rg>.",
      "condition": "[and(equals(length(split(variables('allScopes')[copyIndex()], '/')), 5), equals(split(variables('allScopes')[copyIndex()], '/')[2], subscription().subscriptionId))]",
      "copy": {
        "name": "resourceGroupScopeCopy",
        "count": "[length(variables('allScopes'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('mr-rg-{0}', copyIndex())]",
      "resourceGroup": "[if(greater(length(split(variables('allScopes')[copyIndex()], '/')), 4), split(variables('allScopes')[copyIndex()], '/')[4], parameters('resourceGroupName'))]",
      "dependsOn": [
        "[variables('identityDeploymentId')]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": {
              "type": "string"
            },
            "roleId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('principalId'), parameters('roleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        },
        "parameters": {
          "principalId": {
            "value": "[reference(variables('identityDeploymentId'), '2022-09-01').outputs.principalId.value]"
          },
          "roleId": {
            "value": "[variables('monitoringReaderRoleId')]"
          }
        }
      }
    },
    {
      "comments": "Single-resource assignments: scope IDs with more than 5 segments. Deployed into the resource's own resource group and attached to the resource via the extension-resource 'scope' property.",
      "condition": "[and(greater(length(split(variables('allScopes')[copyIndex()], '/')), 5), equals(split(variables('allScopes')[copyIndex()], '/')[2], subscription().subscriptionId))]",
      "copy": {
        "name": "resourceScopeCopy",
        "count": "[length(variables('allScopes'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('mr-res-{0}', copyIndex())]",
      "resourceGroup": "[if(greater(length(split(variables('allScopes')[copyIndex()], '/')), 4), split(variables('allScopes')[copyIndex()], '/')[4], parameters('resourceGroupName'))]",
      "dependsOn": [
        "[variables('identityDeploymentId')]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": {
              "type": "string"
            },
            "roleId": {
              "type": "string"
            },
            "targetScope": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[parameters('targetScope')]",
              "name": "[guid(parameters('targetScope'), parameters('principalId'), parameters('roleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        },
        "parameters": {
          "principalId": {
            "value": "[reference(variables('identityDeploymentId'), '2022-09-01').outputs.principalId.value]"
          },
          "roleId": {
            "value": "[variables('monitoringReaderRoleId')]"
          },
          "targetScope": {
            "value": "[variables('allScopes')[copyIndex()]]"
          }
        }
      }
    },
    {
      "copy": {
        "name": "kustoViewerCopy",
        "count": "[length(parameters('kustoClusterIds'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('kustoViewer-{0}', copyIndex())]",
      "resourceGroup": "[if(greater(length(split(parameters('kustoClusterIds')[copyIndex()], '/')), 4), split(parameters('kustoClusterIds')[copyIndex()], '/')[4], parameters('resourceGroupName'))]",
      "dependsOn": [
        "[variables('identityDeploymentId')]"
      ],
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "clusterName": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            },
            "assignmentName": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Kusto/clusters/principalAssignments",
              "apiVersion": "2023-05-02",
              "name": "[format('{0}/{1}', parameters('clusterName'), parameters('assignmentName'))]",
              "properties": {
                "principalId": "[parameters('clientId')]",
                "principalType": "App",
                "role": "AllDatabasesViewer",
                "tenantId": "[parameters('tenantId')]"
              }
            }
          ]
        },
        "parameters": {
          "clusterName": {
            "value": "[last(split(parameters('kustoClusterIds')[copyIndex()], '/'))]"
          },
          "clientId": {
            "value": "[reference(variables('identityDeploymentId'), '2022-09-01').outputs.clientId.value]"
          },
          "tenantId": {
            "value": "[subscription().tenantId]"
          },
          "assignmentName": {
            "value": "[format('grafana-kusto-viewer-{0}', uniqueString(reference(variables('identityDeploymentId'), '2022-09-01').outputs.clientId.value))]"
          }
        }
      },
      "condition": "[equals(split(parameters('kustoClusterIds')[copyIndex()], '/')[2], subscription().subscriptionId)]"
    }
  ],
  "outputs": {
    "clientId": {
      "type": "string",
      "value": "[reference(variables('identityDeploymentId'), '2022-09-01').outputs.clientId.value]"
    },
    "tenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "instructions": {
      "type": "string",
      "value": "Copy clientId, tenantId, and subscriptionId above into Grafana's Azure Monitor (secretless) datasource, or paste them where the Connect flow asked for them. If you listed kustoClusterIds, this identity can now query those clusters too."
    },
    "ignoredScopes": {
      "type": "array",
      "value": "[concat(filter(variables('allScopes'), lambda('s', not(equals(split(lambdaVariables('s'), '/')[2], subscription().subscriptionId)))), filter(parameters('kustoClusterIds'), lambda('s', not(equals(split(lambdaVariables('s'), '/')[2], subscription().subscriptionId)))))]"
    },
    "managedIdentityName": {
      "type": "string",
      "value": "[variables('identityName')]"
    }
  }
}
